# ═══════════════════════════════════════════════════════════
# NEXUS QUANT FLOOR — .env.example
# Copia a .env y rellena. NUNCA commitees .env.
# ═══════════════════════════════════════════════════════════

# ─── Runtime ───
ENVIRONMENT=laptop                 # laptop | oracle | hetzner
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# ─── Paths ───
DUCKDB_PATH=./data/processed/analytics.duckdb
KUZUDB_PATH=./data/knowledge_graph/kuzu.db
SQLITE_VEC_PATH=./data/processed/vectors.db
SQLITE_META_PATH=./data/processed/meta.db
RAW_DATA_PATH=./data/raw

# ─── Redis (event bus + Celery broker) ───
# Laptop: localhost. Oracle: <tailscale-ip-oracle>:6379
REDIS_URL=redis://localhost:6379

# ─── LLMs ───
# Laptop: localhost. Oracle: <tailscale-ip-oracle>:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_DAILY=llama3.1:8b-instruct-q4_K_M
OLLAMA_MODEL_CODER=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_GPU_LAYERS=0

# ─── Embeddings ───
EMBEDDINGS_URL=http://localhost:8080

# ─── Data sources ───
# Yahoo Finance: sin clave (futuros con retraso)
YAHOO_ENABLED=true

# Databento (opcional, $125 crédito gratis al registrarse)
# https://databento.com — compra única de 1m histórico real
DATABENTO_API_KEY=

# Tradovate demo (vía Lucid) — si obtienes acceso API
TRADOVATE_DEMO_URL=
TRADOVATE_DEMO_TOKEN=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=

# Rithmic demo (opcional, para L2 / microstructure)
RITHMIC_DEMO_URL=
RITHMIC_DEMO_TOKEN=

# FRED (macro gratis)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# OANDA demo (FX correlaciones)
OANDA_DEMO_TOKEN=

# ─── VPN ───
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=

# ─── Risk / trading ───
# Todo paper hasta validación. NO cambies a false sin pasar todos los gates.
PAPER_ONLY=true
MAX_DAILY_LOSS_USD=1500
MAX_TRAILING_DD_USD=2500
CONSISTENCY_RULE_PCT=50

# ─── Validation gates (el árbitro) ───
MIN_SHARPE=1.5
MIN_NET_SHARPE=1.0
MAX_DRAWDOWN_PCT=0.15
MAX_PARAM_DRIFT_PCT=20
MIN_TRADES=100
MIN_FOLDS=8
OOS_LOCK_DAYS=60

# ─── Security ───
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# ─── Monitoring ───
GRAFANA_PASSWORD=admin
